<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Al Noor Passkey Test</title>
<style>
body{
  background:#0b0907;
  color:#f4ead9;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  padding:25px;
}
.box{
  max-width:600px;
  margin:auto;
  background:#17130f;
  border:1px solid #3b2d1c;
  border-radius:18px;
  padding:22px;
}
h1{text-align:center}
button{
  width:100%;
  padding:17px;
  border:0;
  border-radius:14px;
  background:#cbaa62;
  font-weight:800;
  font-size:16px;
}
#result{
  margin-top:20px;
  padding:15px;
  border-radius:12px;
  background:#211b15;
  word-break:break-word;
}
</style>
</head>

<body>

<div class="box">

<h1>AL NOOR</h1>

<p>
This test does NOT force a platform authenticator.
It does NOT use Supabase.
</p>

<button id="btn" onclick="test()">
TEST PASSKEY CREATION
</button>

<div id="result">
Ready...
</div>

</div>

<script>

async function test(){

const btn=document.getElementById("btn");
const result=document.getElementById("result");

btn.disabled=true;
btn.innerText="WAITING...";

try{

if(!window.isSecureContext)
throw new Error("HTTPS is required.");

if(!window.PublicKeyCredential)
throw new Error("WebAuthn is not supported.");

let platform="unknown";

if(
typeof PublicKeyCredential
.isUserVerifyingPlatformAuthenticatorAvailable
==="function"
){
platform=
await PublicKeyCredential
.isUserVerifyingPlatformAuthenticatorAvailable();
}

const challenge=new Uint8Array(32);
const userId=new Uint8Array(16);

crypto.getRandomValues(challenge);
crypto.getRandomValues(userId);

const credential=
await navigator.credentials.create({

publicKey:{

challenge:challenge,

rp:{
name:"Al Noor Diagnostic",
id:location.hostname
},

user:{
id:userId,
name:"diagnostic@alnoor.local",
displayName:"Al Noor Diagnostic"
},

pubKeyCredParams:[
{
type:"public-key",
alg:-7
},
{
type:"public-key",
alg:-257
}
],

authenticatorSelection:{
residentKey:"preferred",
userVerification:"preferred"
},

timeout:60000,

attestation:"none"

}

});

if(!credential)
throw new Error("No credential returned.");

result.innerHTML=
"<b style='color:#35d06f'>PASSKEY CREATION SUCCEEDED ✅</b><br><br>"+
"Credential type: "+
credential.type+
"<br><br>"+
"Platform authenticator reported: "+
platform;

}
catch(e){

result.innerHTML=
"<b style='color:#ff5d5d'>PASSKEY CREATION FAILED ❌</b><br><br>"+
"<b>Name:</b> "+
(e.name||"Unknown")+
"<br><br>"+
"<b>Message:</b> "+
(e.message||"No message");

}

btn.disabled=false;
btn.innerText="TEST PASSKEY CREATION";

}

</script>

</body>
</html>
